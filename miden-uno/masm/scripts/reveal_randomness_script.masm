# reveal_randomness_script

use.external_contract::uno_contract
use.std::sys

begin
    # 1) Verify stored commitment for player 0
    push.{REVEAL_COMMITMENT_HASH_A}
    push.{REVEAL_COMMITMENT_HASH_B}
    push.{REVEAL_COMMITMENT_HASH_C}
    push.{REVEAL_COMMITMENT_HASH_D}
    push.0                             # idx
    call.uno_contract::verify_commitment

    # 2) Store the revealed secret for player 0
    push.10
    push.20
    push.30
    push.40                            # s0..s3
    push.0                             # idx
    call.uno_contract::store_secret

    exec.sys::truncate_stack
end
